<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Fullscreen Live Matrix Rain Background -->
    <app.matrixrain.MatrixRainView
        android:id="@+id/matrix_rain_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Foreground UI Overlay with safe area padding -->
    <LinearLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <!-- Top Header Terminal Style with Scrim -->
        <LinearLayout
            android:id="@+id/header_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_scrim"
            android:paddingLeft="16dp"
            android:paddingRight="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/header_prompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&gt;_ "
                    android:textColor="#00FF66"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/share_tech_mono" />

                <TextView
                    android:id="@+id/header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="matrixrain"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/share_tech_mono" />
            </LinearLayout>

            <TextView
                android:id="@+id/header_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="AMOLED"
                android:textColor="#648a72"
                android:textSize="13sp"
                android:letterSpacing="0.15"
                android:fontFamily="@font/share_tech_mono" />

        </LinearLayout>

        <!-- Flexible Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Cyberpunk Pill Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/set_wallpaper_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="⚡  Set Live Wallpaper"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/share_tech_mono"
                android:background="@drawable/bg_cyber_button"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/settings_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="⚙  Customization Settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/share_tech_mono"
                android:background="@drawable/bg_cyber_button"
                android:stateListAnimator="@null" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
