<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customization"
            android:textColor="#00FF00"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/text_edition_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="F-Droid FOSS Edition"
            android:textColor="#00FFFF"
            android:textSize="12sp"
            android:background="#112233"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginBottom="16dp"/>

        <!-- Pro Upgrade Banner (Shown on Google Play free edition) -->
        <LinearLayout
            android:id="@+id/banner_pro_upgrade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A3311"
            android:padding="12dp"
            android:layout_marginBottom="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Unlock Matrix Pro"
                android:textColor="#00FF66"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Get unlimited access to Red Virus streams, Gold Neo drops, custom text messages, and touch shockwave ripples."
                android:textColor="#AACCBB"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_unlock_pro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upgrade to Pro (Lifetime)"
                android:backgroundTint="#00FF66"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Density -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rain Density (Text Size)"
            android:textColor="#FFFFFF" />
        <SeekBar
            android:id="@+id/seekbar_density"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="16"
            android:layout_marginBottom="16dp"/>

        <!-- Speed -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rain Speed"
            android:textColor="#FFFFFF" />
        <SeekBar
            android:id="@+id/seekbar_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="30"
            android:layout_marginBottom="16dp"/>

        <!-- Features -->
        <Switch
            android:id="@+id/switch_virus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Red 'Virus' Drops"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switch_gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gold 'Neo' Drops"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switch_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hidden Messages"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switch_depth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Background Depth Layer"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switch_glitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Glitch Effects"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switch_touch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Touch Interaction"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply Settings"
            android:backgroundTint="#00FF00"
            android:textColor="#000000"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>
