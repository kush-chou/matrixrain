<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_settings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:filterTouchesWhenObscured="true">

    <LinearLayout
        android:id="@+id/settings_content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Glowing Terminal Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/settings_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&gt;_ "
                android:textColor="#00FF66"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="@font/share_tech_mono" />

            <TextView
                android:id="@+id/settings_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customization"
                android:textColor="#00FF66"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="@font/share_tech_mono"
                android:shadowColor="#8000FF66"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="12" />
        </LinearLayout>

        <!-- Color Palette Theme Selector -->
        <TextView
            android:id="@+id/label_palette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Color Palette"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/share_tech_mono"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/palette_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <!-- Classic (Green) -->
            <FrameLayout
                android:id="@+id/btn_theme_classic"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Classic Green Theme">

                <View
                    android:id="@+id/ring_theme_classic"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_theme_classic"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Cyan -->
            <FrameLayout
                android:id="@+id/btn_theme_cyan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Cyan Theme">

                <View
                    android:id="@+id/ring_theme_cyan"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_theme_cyan"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Crimson -->
            <FrameLayout
                android:id="@+id/btn_theme_crimson"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Crimson Theme">

                <View
                    android:id="@+id/ring_theme_crimson"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_theme_crimson"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Amber -->
            <FrameLayout
                android:id="@+id/btn_theme_amber"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Amber Theme">

                <View
                    android:id="@+id/ring_theme_amber"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_theme_amber"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Violet -->
            <FrameLayout
                android:id="@+id/btn_theme_violet"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Violet Theme">

                <View
                    android:id="@+id/ring_theme_violet"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_theme_violet"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Monochrome -->
            <FrameLayout
                android:id="@+id/btn_theme_monochrome"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Monochrome Theme">

                <View
                    android:id="@+id/ring_theme_monochrome"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:visibility="invisible" />

                <View
                    android:id="@+id/dot_theme_monochrome"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center" />
            </FrameLayout>

        </LinearLayout>

        <!-- Density -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Glyph Size"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/share_tech_mono" />

        <SeekBar
            android:id="@+id/seekbar_density"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:progressTint="#00FF66"
            android:thumbTint="#00FF66"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Speed -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cascade Speed"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/share_tech_mono" />

        <SeekBar
            android:id="@+id/seekbar_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="70"
            android:progressTint="#00FF66"
            android:thumbTint="#00FF66"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Section Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2000FF66"
            android:layout_marginBottom="20dp" />

        <!-- Features -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_virus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Red 'Virus' Drops"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/share_tech_mono"
            android:checked="true"
            app:thumbTint="#00FF66"
            app:trackTint="#4000FF66"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gold 'Neo' Drops"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/share_tech_mono"
            android:checked="true"
            app:thumbTint="#00FF66"
            app:trackTint="#4000FF66"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hidden Messages"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/share_tech_mono"
            android:checked="true"
            app:thumbTint="#00FF66"
            app:trackTint="#4000FF66"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_depth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Background Depth Layer"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/share_tech_mono"
            android:checked="true"
            app:thumbTint="#00FF66"
            app:trackTint="#4000FF66"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_glitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Glitch Effects"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/share_tech_mono"
            android:checked="true"
            app:thumbTint="#00FF66"
            app:trackTint="#4000FF66"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_touch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Touch Interaction"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/share_tech_mono"
            android:checked="true"
            app:thumbTint="#00FF66"
            app:trackTint="#4000FF66"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="16dp" />

        <!-- Apply Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_apply"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Apply Settings"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/share_tech_mono"
            android:background="@drawable/bg_apply_button"
            android:stateListAnimator="@null"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
