<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipToPadding="false"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customization"
            android:textColor="#00FF00"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- Density -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rain Density (Text Size)"
            android:textColor="#FFFFFF" />
        <SeekBar
            android:id="@+id/seekbar_density"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="16"
            android:layout_marginBottom="16dp"/>

        <!-- Speed -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rain Speed"
            android:textColor="#FFFFFF" />
        <SeekBar
            android:id="@+id/seekbar_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="30"
            android:layout_marginBottom="16dp"/>

        <!-- Features -->
        <Switch
            android:id="@+id/switch_virus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Red 'Virus' Drops"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switch_gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gold 'Neo' Drops"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switch_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hidden Messages"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switch_depth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Background Depth Layer"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switch_glitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Glitch Effects"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switch_touch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Touch Interaction"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btn_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply Settings"
            android:backgroundTint="#00FF00"
            android:textColor="#000000"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
</ScrollView>
